# Root Azure AI Language resource endpoint (not a project endpoint).
LANGUAGE_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com

# Azure region used to resolve official Microsoft retail pricing.
AZURE_REGION=eastus2

# Optional. Conversation API version. DateOfBirth and other preview
# categories require 2025-11-15-preview plus an explicit PII_CATEGORIES list.
# LANGUAGE_API_VERSION=2024-11-01
# PII_CATEGORIES=Person,Phone,Email,Address,CreditCard,DateOfBirth

# Optional. Browser origins allowed to call the API cross-origin.
# CORS_ALLOW_ORIGINS=https://your-app.example.com
